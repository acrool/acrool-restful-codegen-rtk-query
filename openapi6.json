{
  "openapi": "3.0.1",
  "info": {
    "title": "測試合規",
    "description": "",
    "version": "1.0.0"
  },
  "tags": [],
  "paths": {
    "/manager/admin/login": {
      "post": {
        "summary": "管理員登入",
        "deprecated": false,
        "description": "",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLoginRequestVO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AdminLoginResponseVO"
                    }
                  ]
                },
                "example": {
                  "code": 0,
                  "errorMessage": "",
                  "success": true,
                  "token": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJjaGloYW8iLCJhdWQiOiJMb2dpbiIsImV4cCI6MTc0ODMzMTQxNiwiaWF0IjoxNzQ4MzI0MjE2LCJqdGkiOiJNYW5hZ2VyIn0.Cde2dc6FKToxMBrxKbOZ4klxEE7ehs-zAYfKR_ola4k"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "分组ID编号"
          },
          "name": {
            "type": "string",
            "description": "分组名称"
          }
        },
        "xml": {
          "name": "Category"
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "标签ID编号"
          },
          "name": {
            "type": "string",
            "description": "标签名称"
          }
        },
        "xml": {
          "name": "Tag"
        }
      },
      "AdminLoginRequestVO": {
        "description": "登入 - 請求",
        "properties": {
          "account": {
            "description": "帳號",
            "type": "string",
            "examples": [
              "account"
            ]
          },
          "password": {
            "description": "密碼",
            "type": "string",
            "examples": [
              "passw0rd"
            ]
          }
        },
        "required": [
          "account",
          "password"
        ],
        "type": "object"
      },
      "AdminLoginResponseVO": {
        "description": "登入 - 回應",
        "properties": {
          "authStatus": {
            "description": "null or PASS : 不需進入二階段驗證, WAIT_TWO_PHASES : 需二階段驗證",
            "enum": [
              "null",
              "PASS",
              "WAIT_TWO_PHASES"
            ],
            "type": "string",
            "examples": [
              "null"
            ]
          },
          "code": {
            "description": "錯誤代碼",
            "format": "int32",
            "type": "integer",
            "examples": [
              0
            ]
          },
          "errorMessage": {
            "description": "錯誤訊息",
            "type": "string",
            "examples": [
              ""
            ]
          },
          "forceAuth": {
            "description": "綁定二次驗證",
            "type": "boolean",
            "examples": [
              false
            ]
          },
          "mustChangePassword": {
            "description": "是否必須修改密碼",
            "type": "boolean",
            "examples": [
              false
            ]
          },
          "success": {
            "description": "是否成功",
            "type": "boolean",
            "examples": [
              true
            ]
          },
          "token": {
            "description": "Token",
            "type": "string",
            "examples": [
              "eyJhbGciOiJIUzI1NiJ9"
            ]
          }
        },
        "type": "object"
      },
      "AdminVO": {
        "description": "管理員帳號列表 - 回應物件",
        "properties": {
          "account": {
            "description": "帳號",
            "type": "string",
            "examples": [
              "account"
            ]
          },
          "authStatus": {
            "description": "是否已綁定登入驗證",
            "type": "boolean",
            "examples": [
              false
            ]
          },
          "createTime": {
            "description": "加入時間",
            "type": "string",
            "examples": [
              "2023-01-01 00:00:00"
            ]
          },
          "forceAuth": {
            "description": "綁定二次驗證",
            "type": "boolean",
            "examples": [
              false
            ]
          },
          "lastLoginIP": {
            "description": "最後登入 IP",
            "type": "string",
            "examples": [
              "0.0.0.0"
            ]
          },
          "lastLoginTime": {
            "description": "最後登入時間",
            "type": "string",
            "examples": [
              "2023-03-23 00:00:00"
            ]
          },
          "mail": {
            "description": "信箱",
            "type": "string",
            "examples": [
              "123@abc.cc"
            ]
          },
          "mailVerify": {
            "description": "信箱驗證",
            "type": "boolean",
            "examples": [
              false
            ]
          },
          "nickname": {
            "description": "暱稱",
            "type": "string",
            "examples": [
              "nickname"
            ]
          },
          "roles": {
            "description": "角色",
            "items": {
              "type": "string"
            },
            "type": "array",
            "examples": [
              [
                "ADMIN",
                "AGENT"
              ]
            ]
          },
          "status": {
            "description": "狀態",
            "enum": [
              "active",
              "inactive",
              "delete"
            ],
            "type": "string",
            "examples": [
              "active"
            ]
          }
        },
        "type": "object"
      },
      "DateColumn": {
        "description": "清單",
        "properties": {
          "bet": {
            "$ref": "#/components/schemas/KanbanDetailVO"
          },
          "date": {
            "type": "string"
          },
          "validBet": {
            "$ref": "#/components/schemas/KanbanDetailVO"
          },
          "winLose": {
            "$ref": "#/components/schemas/KanbanDetailVO"
          }
        },
        "type": "object"
      },
      "KanbanDetailVO": {
        "description": "損益物件",
        "properties": {
          "amount": {
            "description": "金額",
            "format": "double",
            "type": "number",
            "examples": [
              100
            ]
          },
          "count": {
            "description": "筆數",
            "format": "int64",
            "type": "integer",
            "examples": [
              100
            ]
          },
          "people": {
            "description": "人數",
            "format": "int64",
            "type": "integer",
            "examples": [
              100
            ]
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {}
  },
  "servers": [],
  "security": []
}
